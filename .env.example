# Copiar a .env y completar con tus valores locales / de Render.

# Local (Postgres corriendo en tu Mac):
DATABASE_URL=DATABASE_URL="postgresql://postgres:TU_PASSWORD_REAL@localhost:5433/tdj_db?schema=public"

PORT=4000

# Origen(es) permitidos para CORS, separados por coma.
# Local: http://localhost:5173
# Producción: https://tu-proyecto.vercel.app
CORS_ORIGIN="http://localhost:5173"

# Secreto para firmar los JWT de login (Fase 5). Generá uno fuerte y
# random en producción, por ejemplo con: openssl rand -base64 48
JWT_SECRET="cambiar-este-secreto-en-produccion"

# Contraseña del administrador que crea `npm run seed` (opcional,
# por defecto "catedra2026" — cambiarla después del primer login).
SEED_ADMIN_PASSWORD="catedra2026"

# Carga de archivos (Fase 6). Carpeta donde se guardan los archivos subidos.
# En Render: agregar un disco persistente montado en esta ruta (requiere
# plan Starter o superior) para que no se pierdan en cada redeploy o
# reinicio — el filesystem del contenedor es efímero sin disco. Ver DEPLOY.md.
UPLOADS_DIR="./uploads"

# URL pública base para construir los links a los archivos subidos.
# Dejar vacío en desarrollo (se arma sola con el host de la request).
# En producción, la URL pública real del servicio en Render, ej:
# PUBLIC_BASE_URL="https://tdj-backend.onrender.com"
PUBLIC_BASE_URL=
